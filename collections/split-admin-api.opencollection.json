{
  "opencollection": "1.0.0",
  "info": {
    "name": "Split Admin API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Admin",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Ping service",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.split.io/internal/api/v2/admin/ping"
          },
          "docs": "Checks whether the Split Evaluator service is running. If the service is running, it responds with the text pong and HTTP status code 200."
        },
        {
          "info": {
            "name": "Get service version",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.split.io/internal/api/v2/admin/version"
          },
          "docs": "Returns the current version of the Split Evaluator service."
        },
        {
          "info": {
            "name": "Health check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.split.io/internal/api/v2/admin/healthcheck"
          },
          "docs": "Checks that the Split Evaluator is connected to Split servers and ready to process evaluation requests. Returns 200 if everything is working as expected or 500 if there is an issue, along with a message explaining the status."
        }
      ]
    }
  ],
  "bundled": true
}