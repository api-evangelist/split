        {
          "id": "3dc7dd1c-50ba-4f0f-a68c-0f2167350a89",
          "name": "Get treatment for a feature flag",
          "request": {
            "name": "Get treatment for a feature flag",
            "description": {
              "content": "Evaluates a single feature flag for the given key and returns the treatment value. Optionally includes dynamic configuration associated with the treatment. This is the primary endpoint for feature flag evaluation.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "client",
                "get-treatment"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) The customer key to evaluate the feature flag against"
                },
                {
                  "disabled": false,
                  "key": "split-name",
                  "value": "<string>",
                  "description": "(Required) The name of the feature flag to evaluate"
                },
                {
                  "disabled": false,
                  "key": "bucketing-key",
                  "value": "<string>",
                  "description": "Optional bucketing key used for consistent percentage-based treatment assignments"
                },
                {
                  "disabled": false,
                  "key": "attributes",
                  "value": "<string>",
                  "description": "JSON string of attributes used in targeting rule evaluation"
                },
                {
                  "disabled": false,
                  "key": "impressions-disabled",
                  "value": "<boolean>",
                  "description": "When set to true, disables impression logging for this evaluation"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
