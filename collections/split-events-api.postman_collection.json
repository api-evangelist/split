      "name": "Events",
      "description": {
        "content": "Endpoints for tracking custom events used in experimentation and metrics measurement.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "a83ad4e8-fa5c-45b1-bafc-278077a12e7c",
          "name": "Track an event",
          "request": {
            "name": "Track an event",
            "description": {
              "content": "Records a custom event for the given key and event type. Events are used to measure the impact of feature flags on user actions and experimentation metrics.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "client",
                "track"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) The customer key associated with the event"
                },
                {
                  "disabled": false,
                  "key": "traffic-type",
                  "value": "<string>",
                  "description": "(Required) The traffic type for the event"
                },
                {
                  "disabled": false,
                  "key": "event-type",
                  "value": "<string>",
                  "description": "(Required) The type of event being tracked (e.g., purchase, click, signup)"
                },
                {
                  "disabled": false,
                  "key": "value",
                  "value": "<number>",
                  "description": "Optional numeric value associated with the event"
                },
                {
                  "disabled": false,
                  "key": "properties",
                  "value": "<string>",
                  "description": "JSON string with up to 15 key-value pairs of event properties. Values must be boolean, string, number, or null."
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": null
          },
