          "item": [
            {
              "name": "Track an event",
              "id": "cefe05d4-f989-404e-b6f6-a247483e9107",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/client/track?key=<string>&traffic-type=<string>&event-type=<string>&value=<number>&properties=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "client",
                    "track"
                  ],
                  "query": [
                    {
                      "description": "(Required) The customer key associated with the event",
                      "key": "key",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) The traffic type for the event",
                      "key": "traffic-type",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) The type of event being tracked (e.g., purchase, click, signup)",
                      "key": "event-type",
                      "value": "<string>"
                    },
                    {
                      "description": "Optional numeric value associated with the event",
                      "key": "value",
                      "value": "<number>"
                    },
                    {
                      "description": "JSON string with up to 15 key-value pairs of event properties. Values must be boolean, string, number, or null.",
                      "key": "properties",
                      "value": "<string>"
                    }
                  ]
                },
                "description": "Records a custom event for the given key and event type. Events are used to measure the impact of feature flags on user actions and experimentation metrics."
              },
